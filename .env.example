# ─── API Mercado Público ──────────────────────────────────────────────────────
# Tu ticket: https://www.mercadopublico.cl/Modules/Cuenta/Login.aspx
VITE_MERCADO_PUBLICO_TICKET=tu_ticket_aqui
MERCADO_PUBLICO_TICKET=tu_ticket_aqui

# ─── Resend (emails) ──────────────────────────────────────────────────────────
# API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Dominio verificado en Resend (Domains)
FROM_EMAIL=alertas@tudominio.cl

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Settings → API en tu proyecto de Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Para Netlify Functions (mismo valor, sin prefijo VITE_)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Seguridad cron ───────────────────────────────────────────────────────────
# Protege el endpoint /check-alerts. Genera con: openssl rand -hex 32
CRON_SECRET=genera_un_token_secreto_aleatorio

# ─── Dev local ────────────────────────────────────────────────────────────────
PORT=3001
